<script>
  window.theme = {
    pageType: '{{ request.page_type }}',
    cartCount: {{ cart.item_count | default: 0 }},
    moneyFormat: '{{ shop.money_format | escape }}',
    moneyWithCurrencyFormat: '{{ shop.currency }}',
    showDiscount: {{ settings.show_discount | default: false }},
    discountMode: '{{ settings.discount_mode | default: "" }}',
    searchMode: '{{ settings.search_mode | default: "" }}',
    cartType: '{{ settings.cart_type | default: "" }}'
  };
  window.routes = {
    cart_add_url: '{{ routes.cart_add_url }}',
    cart_url: '{{ routes.cart_url }}',
    root_url: '{{ routes.root_url }}'
  };
  window.languages = {
    search_placeholder: '{{ "general.search.search" | t }}',
    add_to_cart: '{{ "products.product.add_to_cart" | t }}',
    sold_out: '{{ "products.product.sold_out" | t }}'
  };
  window.lazySizesConfig = window.lazySizesConfig || {};
  window.lazySizesConfig.customMedia = {
    '--small': '(max-width: 420px)',
    '--medium': '(max-width: 1024px)'
  };
</script>

