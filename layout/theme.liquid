{% if request.page_type != 'cart' %}
  <script>
    window.addEventListener('pageshow', function(event) {
      try {
        if (event.persisted || (window.performance && window.performance.getEntriesByType)) {
          if (typeof fetch === 'function') {
            fetch(window.routes.cart_url || '/cart.js', { credentials: 'same-origin' }).then(function(){ document.dispatchEvent(new Event('cart:refresh')); }).catch(function(){});
          } else {
            document.dispatchEvent(new Event('cart:refresh'));
          }
        }
      } catch(e){}
    });
  </script>
{% endif %}

