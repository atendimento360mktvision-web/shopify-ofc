<header class="site-header">

  <!-- Logomarca -->
  <h1 class="header__logo">
    {% if section.settings.logo != blank %}
      <a href="{{ routes.root_url }}">
        <img src="{{ section.settings.logo | img_url: '200x' }}" alt="{{ shop.name }}">
      </a>
    {% else %}
      {{ shop.name | link_to: routes.root_url }}
    {% endif %}
  </h1>

  <!-- Data Atual + Promoção + Cronômetro -->
  <div class="header__topbar">
    <span class="header__date">{{ "now" | date: "%d/%m/%Y" }}</span>
    <span class="header__promo">{{ section.settings.promo_text }}</span>
    <span class="header__timer" id="flash-sale-timer" data-endtime="{{ section.settings.promo_timer }}">
      Oferta termina em: <strong id="timer-countdown"></strong>
    </span>
  </div>

  <!-- Barra de Navegação -->
  <nav class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </nav>

  <!-- Barra de Pesquisa -->
  <div class="header__search">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input type="search" name="q" placeholder="Buscar produtos..." aria-label="Buscar">
      <button type="submit">
        {{ 'icon-search.svg' | inline_asset_content }}
      </button>
    </form>
  </div>

  <!-- Ícones -->
  <div class="header__icons">

    <!-- Rastreamento -->
    <a href="/pages/rastrear-pedido">
      {{ 'icon-track.svg' | inline_asset_content }}
    </a>

    <!-- Idioma / País -->
    <a href="/localization">
      {{ 'icon-globe.svg' | inline_asset_content }}
    </a>

    <!-- Conta / Login -->
    {% if shop.customer_accounts_enabled %}
      {% if customer %}
        <a href="{{ routes.account_url }}">
          {{ 'icon-account.svg' | inline_asset_content }}
          <span class="username">{{ customer.first_name }}</span>
        </a>
      {% else %}
        <a href="{{ routes.account_login_url }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}
    {% endif %}

    <!-- Carrinho -->
    <a href="{{ routes.cart_url }}" class="header__cart">
      {{ 'icon-cart.svg' | inline_asset_content }}
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}
    </a>
  </div>

</header>

<!-- Script Cronômetro -->
<script>
document.addEventListener("DOMContentLoaded", function(){
  var timerElement = document.getElementById("timer-countdown");
  var timerContainer = document.getElementById("flash-sale-timer");
  if(timerContainer){
    var endTime = timerContainer.dataset.endtime;
    if(endTime){
      var countDownDate = new Date(endTime).getTime();
      var x = setInterval(function(){
        var now = new Date().getTime();
        var distance = countDownDate - now;
        if(distance < 0){
          clearInterval(x);
          timerElement.innerHTML = "Expirado";
        } else {
          var hours = Math.floor((distance % (1000*60*60*24)) / (1000*60*60));
          var minutes = Math.floor((distance % (1000*60*60)) / (1000*60));
          var seconds = Math.floor((distance % (1000*60)) / 1000);
          timerElement.innerHTML = hours + "h " + minutes + "m " + seconds + "s";
        }
      }, 1000);
    }
  }
});
</script>

{% stylesheet %}
.site-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.5rem 1rem;
}

.header__logo img {
  max-height: 50px;
}

.header__topbar {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  font-size: 0.85rem;
  color: var(--color-foreground);
}

.header__menu {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

.header__search form {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}
.header__search input {
  padding: 0.25rem 0.5rem;
}

.header__icons {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.header__icons svg {
  width: 1.8rem;
  height: 1.8rem;
}
.header__cart {
  position: relative;
}
.header__cart sup {
  position: absolute;
  top: -0.5rem;
  right: -0.5rem;
  background: red;
  color: white;
  border-radius: 50%;
  padding: 0.2rem 0.4rem;
  font-size: 0.7rem;
}

@media (max-width: 768px) {
  .site-header {
    flex-direction: column;
    align-items: flex-start;
  }
  .header__menu {
    justify-content: center;
    width: 100%;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Cabeçalho Avançado",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logomarca"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Texto da promoção",
      "default": "Frete grátis em pedidos acima de R$199!"
    },
    {
      "type": "text",
      "id": "promo_timer",
      "label": "Data final da oferta (YYYY-MM-DDTHH:MM:SS)",
      "default": "2025-12-31T23:59:59"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu de navegação"
    }
  ]
}
{% endschema %}
