<header class="site-header">

  <!-- Barra Superior (promo/frete/localização) -->
  <div class="header__topbar">
    <div class="container">
      <span class="header__location">
        {{ 'icon-location.svg' | inline_asset_content }}
        {{ section.settings.promo_text }}
      </span>
    </div>
  </div>

  <!-- Linha Principal: Logo + Busca + Ícones -->
  <div class="header__main">
    <div class="container header__main-wrapper">

      <!-- Logomarca -->
      <div class="header__logo">
        {% if section.settings.logo != blank %}
          <a href="{{ routes.root_url }}">
            <img src="{{ section.settings.logo | img_url: '200x' }}" alt="{{ shop.name }}">
          </a>
        {% else %}
          <h1>{{ shop.name | link_to: routes.root_url }}</h1>
        {% endif %}
      </div>

      <!-- Barra de Pesquisa -->
      <div class="header__search">
        <form action="{{ routes.search_url }}" method="get" role="search">
          <input type="search" name="q" placeholder="Search..." aria-label="Buscar">
          <button type="submit">
            {{ 'icon-search.svg' | inline_asset_content }}
          </button>
        </form>
      </div>

      <!-- Ícones -->
      <div class="header__icons">
        <!-- Rastreamento -->
        <a href="/pages/rastrear-pedido" title="Rastrear Pedido">
          {{ 'icon-track.svg' | inline_asset_content }}
        </a>
        <!-- Conta -->
        {% if shop.customer_accounts_enabled %}
          {% if customer %}
            <a href="{{ routes.account_url }}" title="Minha Conta">
              {{ 'icon-account.svg' | inline_asset_content }}
            </a>
          {% else %}
            <a href="{{ routes.account_login_url }}" title="Entrar">
              {{ 'icon-account.svg' | inline_asset_content }}
            </a>
          {% endif %}
        {% endif %}
        <!-- Carrinho -->
        <a href="{{ routes.cart_url }}" class="header__cart" title="Carrinho">
          {{ 'icon-cart.svg' | inline_asset_content }}
          {% if cart.item_count > 0 %}
            <sup>{{ cart.item_count }}</sup>
          {% endif %}
        </a>
      </div>
    </div>
  </div>

  <!-- Menu Inferior -->
  <nav class="header__menu">
    <div class="container">
      <ul>
        <li class="menu-icon">{{ 'icon-menu.svg' | inline_asset_content }}</li>
        {% for link in section.settings.menu.links %}
          <li>{{ link.title | link_to: link.url }}</li>
        {% endfor %}
      </ul>
    </div>
  </nav>
</header>

{% stylesheet %}
/* ===== Estrutura Geral ===== */
.site-header {
  font-family: inherit;
  color: white;
}

/* Barra superior */
.header__topbar {
  background: #0a2a47;
  color: #fff;
  font-size: 0.85rem;
  padding: 0.3rem 1rem;
}
.header__topbar .container {
  display: flex;
  align-items: center;
  justify-content: center;
}
.header__location {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.header__location svg {
  width: 1rem;
  height: 1rem;
}

/* Linha principal */
.header__main {
  background: #00264d;
  padding: 0.8rem 1rem;
}
.header__main-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.header__logo img {
  max-height: 50px;
}

/* Busca */
.header__search {
  flex: 1;
  display: flex;
  justify-content: center;
}
.header__search form {
  display: flex;
  width: 100%;
  max-width: 600px;
  background: #fff;
  border-radius: 6px;
  overflow: hidden;
}
.header__search input {
  flex: 1;
  border: none;
  padding: 0.6rem;
  font-size: 1rem;
  outline: none;
}
.header__search button {
  background: #00e676;
  border: none;
  padding: 0 1rem;
  cursor: pointer;
}
.header__search button svg {
  width: 1.2rem;
  height: 1.2rem;
  fill: #fff;
}

/* Ícones */
.header__icons {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.header__icons svg {
  width: 1.8rem;
  height: 1.8rem;
}
.header__cart {
  position: relative;
}
.header__cart sup {
  position: absolute;
  top: -0.4rem;
  right: -0.6rem;
  background: #00e676;
  color: #000;
  border-radius: 50%;
  padding: 0.15rem 0.45rem;
  font-size: 0.75rem;
  font-weight: bold;
}

/* Menu inferior */
.header__menu {
  background: #00264d;
  border-top: 1px solid rgba(255,255,255,0.1);
}
.header__menu .container {
  display: flex;
  justify-content: center;
}
.header__menu ul {
  list-style: none;
  display: flex;
  gap: 2rem;
  padding: 0.8rem 0;
  margin: 0;
}
.header__menu a {
  text-decoration: none;
  color: #fff;
  font-weight: 600;
}
.header__menu .menu-icon svg {
  width: 1.2rem;
  height: 1.2rem;
}

/* Responsividade */
@media (max-width: 768px) {
  .header__main-wrapper {
    flex-direction: column;
    align-items: flex-start;
  }
  .header__search {
    order: 2;
    width: 100%;
  }
  .header__icons {
    order: 3;
    justify-content: flex-end;
    width: 100%;
  }
  .header__menu ul {
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Cabeçalho Estilo Premium",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logomarca"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Texto da barra superior",
      "default": "Frete grátis para todo o Brasil!"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu de navegação"
    }
  ]
}
{% endschema %}
